{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the application, potentially an admin.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's email address"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "user"],
          "description": "User's role for RBAC"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "role"]
    },
    "Lead": {
      "title": "Lead",
      "description": "A captured lead from one of the forms.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Lead's full name"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Lead's email address"
        },
        "company": {
          "type": "string",
          "description": "Lead's company name"
        },
        "source": {
          "type": "string",
          "description": "The form or page where the lead was captured"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "source", "createdAt"]
    },
    "Visitor": {
      "title": "Visitor",
      "description": "A unique visitor tracked via localStorage.",
      "type": "object",
      "properties": {
        "firstVisit": {
          "type": "string",
          "format": "date-time"
        },
        "lastVisit": {
          "type": "string",
          "format": "date-time"
        },
        "pageViews": {
          "type": "number"
        }
      },
      "required": ["firstVisit", "lastVisit", "pageViews"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles and roles."
    },
    "/leads/{leadId}": {
      "schema": { "$ref": "#/entities/Lead" },
      "description": "Stores captured leads."
    },
    "/visitors/{visitorId}": {
      "schema": { "$ref": "#/entities/Visitor" },
      "description": "Stores unique visitor analytics."
    }
  }
}
